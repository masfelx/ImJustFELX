# ============================================================
#  CONTOH KONFIGURASI ENV — LUX0RIA
#  Salin file ini menjadi `.env.local` lalu isi nilainya.
#  JANGAN pernah commit `.env.local` ke Git.
# ============================================================

# ── Admin Panel ───────────────────────────────────────────────
# Hash bcrypt dari password admin. Buat dengan:
#   node -e "console.log(require('bcryptjs').hashSync('PASSWORD_KAMU', 12))"
ADMIN_PASSWORD_HASH=

# Kunci acak untuk menandatangani sesi login admin (minimal 32 karakter). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# WAJIB diisi di production. Tanpa ini, seluruh halaman admin menolak akses (503).
JWT_SECRET=

# ── Supabase ──────────────────────────────────────────────────
# Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co

# Publishable / anon key — AMAN dipakai di browser (hanya boleh baca).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret / service role key — KHUSUS SERVER, jangan pernah diberi prefix NEXT_PUBLIC_.
# Diperlukan agar admin, cerita, dan upload bisa MENULIS ke database.
# Buat di: Project Settings -> API Keys -> Secret keys -> Create new secret key
# Kalau key ini salah/kosong: cerita tidak akan tersimpan (muncul error 503).
SUPABASE_SERVICE_ROLE_KEY=
